{
  "name": "ffcadmin.org",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/generate-sites-alerts.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "export": "next build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check-links": "linkinator ./out --config .linkinatorrc.json",
    "data:roadmap": "tsx scripts/generate-roadmap-data.ts",
    "analyze": "ANALYZE=true pnpm build",
    "test:e2e": "playwright test",
    "audit:high": "pnpm audit --prod --audit-level high",
    "prepare": "husky"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@next/bundle-analyzer": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "js-yaml": "^5.3.0",
    "linkinator": "^8.0.4",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18",
      "fast-uri@<3.1.4": ">=3.1.4",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0 <8.0.0",
      "brace-expansion@<1.1.18": ">=1.1.18 <2.0.0",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9 <6.0.0",
      "sharp": "0.35.3",
      "eslint-plugin-react-hooks": "^7.1.1"
    }
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
